 (optional)
#
# The app works 100% without keys: plans fall back to the built-in
# demo generator. Add ONE key below to enable AI-generated plans.
# Providers are tried in the order they appear here.
#
# Copy this file to .env.local and fill in the keys you have.

# Groq (recommended — fast + generous free tier)  https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — one key for 400+ models           https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral La Plateforme                           https://console.mistral.ai/
MISTRAL_API_KEY=

# DeepSeek                                        https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Zhipu GLM (BigModel)                            https://bigmodel.cn/usercenter/proj-mgmt/apikeys
GLM_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini                                   https://aistudio.google.com/apikey
GEMINI_API_KEY=
